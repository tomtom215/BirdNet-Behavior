/* Append to crates/birdnet-web/static/css/app.css — purely additive.
   Skeleton shimmer used by pages::skeletons helpers (O-16). */

/* ── Skeleton shimmer ─────────────────────────────────────────────── */
.bnb-skel {
  display: block;
  background:
    linear-gradient(
      90deg,
      var(--surface-2) 0%,
      color-mix(in oklch, var(--hairline) 65%, var(--surface-2)) 40%,
      color-mix(in oklch, var(--hairline) 65%, var(--surface-2)) 60%,
      var(--surface-2) 100%
    );
  background-size: 200% 100%;
  border-radius: var(--r-sm);
}
@media (prefers-reduced-motion: no-preference) {
  .bnb-skel { animation: bnb-skel-shimmer 1.4s cubic-bezier(.4, 0, .2, 1) infinite; }
}
:root[data-motion="reduced"] .bnb-skel { animation: none; }

@keyframes bnb-skel-shimmer {
  0%   { background-position: 100% 0; }
  100% { background-position: -100% 0; }
}

/* Convenience modifiers — height presets matching the shapes the helpers emit. */
.bnb-skel.line   { height: 12px; border-radius: 3px; }
.bnb-skel.line.lg { height: 20px; }
.bnb-skel.line.xl { height: 32px; }
.bnb-skel.pill   { height: 18px; width: 80px; border-radius: 999px; }
.bnb-skel.dot    { width: 6px; height: 6px; border-radius: 999px; }
.bnb-skel.avatar { width: 28px; height: 28px; border-radius: 999px; flex: 0 0 auto; }
.bnb-skel.avatar.lg { width: 36px; height: 36px; }
.bnb-skel.tile   { height: 110px; border-radius: var(--r-md); }
.bnb-skel.box    { border-radius: var(--r-md); }

/* Composite layouts the helpers use — kept in CSS so server-side helpers stay tiny. */
.bnb-skel-feed-row {
  display: grid;
  grid-template-columns: 64px 36px 1fr 130px 92px auto;
  gap: 12px; align-items: center; padding: 10px;
}
.bnb-skel-stat-row {
  display: grid; grid-template-columns: repeat(var(--n, 4), 1fr); gap: 0;
  border: 0.5px solid var(--border); border-radius: var(--r-lg); overflow: hidden;
  background: var(--surface); box-shadow: var(--shadow-sm);
}
.bnb-skel-stat-row > div {
  padding: var(--pad-3); border-right: 0.5px solid var(--hairline);
  display: flex; flex-direction: column; gap: 12px; min-height: 150px;
}
.bnb-skel-stat-row > div:last-child { border-right: 0; }

.bnb-skel-bars {
  display: grid; grid-template-columns: repeat(var(--n, 24), 1fr);
  gap: 2px; align-items: end; height: 80px;
}
.bnb-skel-bars > span {
  display: block; background: var(--surface-2);
  border-radius: 2px 2px 0 0;
}
@media (prefers-reduced-motion: no-preference) {
  .bnb-skel-bars > span { animation: bnb-skel-shimmer 1.4s cubic-bezier(.4,0,.2,1) infinite; background-size:200% 100%; }
}

.bnb-skel-list { display: flex; flex-direction: column; }
.bnb-skel-list-row {
  display: grid; grid-template-columns: 28px 1fr 56px;
  gap: 12px; align-items: center; padding: 10px 0;
  border-top: 0.5px solid var(--hairline);
}
.bnb-skel-list-row:first-child { border-top: 0; }
