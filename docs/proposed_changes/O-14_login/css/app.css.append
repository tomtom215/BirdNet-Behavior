/* Append to crates/birdnet-web/static/css/app.css — purely additive.
   Login page (O-14). Card-local layout; everything else is design-system. */

/* ── Card chrome ──────────────────────────────────────────────────── */
.login-card {
  width: 100%;
  max-width: 400px;
  padding: 36px 32px 28px !important; /* override default .bnb-card.pad */
  position: relative;
}

.login-card__head {
  display: flex; flex-direction: column; gap: 6px;
  margin-bottom: 22px;
}
.login-card__brand {
  display: inline-flex; align-items: center; gap: 10px;
  margin-bottom: 14px;
  color: var(--fg);
}

/* ── Alert (inline error) ─────────────────────────────────────────── */
.login-alert {
  display: none;
  align-items: flex-start;
  gap: 10px;
  padding: 10px 12px;
  border-radius: var(--r-md);
  background: var(--rare-soft);
  border: 0.5px solid color-mix(in oklch, var(--rare) 35%, transparent);
  color: var(--rare);
  font-size: 12.5px;
  margin-bottom: 16px;
}
.login-alert.is-visible { display: flex; }
.login-alert__dot {
  width: 6px; height: 6px; border-radius: 999px;
  background: var(--rare);
  margin-top: 6px; flex: 0 0 auto;
}
.login-alert__body {
  color: var(--rare);
  font-weight: 500;
}

/* ── Form layout ──────────────────────────────────────────────────── */
.login-form { display: flex; flex-direction: column; gap: 14px; }
.login-field { display: flex; flex-direction: column; gap: 6px; }
.login-field input[type="text"],
.login-field input[type="password"] {
  font-size: 14px;
  padding: 11px 12px;
  border-radius: var(--r-md);
  background: var(--bg-2);
}
.login-field input:focus {
  background: var(--surface);
}
.login-field__withtoggle { position: relative; display: flex; align-items: center; }
.login-field__withtoggle input { padding-right: 60px; flex: 1; }

.login-toggle {
  position: absolute; right: 6px; top: 50%;
  transform: translateY(-50%);
  background: transparent;
  border: 0;
  padding: 6px 8px;
  color: var(--fg-3);
  font-family: var(--font-ui);
  font-size: 11px;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  cursor: pointer;
  border-radius: var(--r-sm);
}
.login-toggle:hover { color: var(--fg); background: var(--surface-2); }

/* ── Remember-me checkbox (replacing the native chrome) ───────────── */
.login-remember {
  display: flex; align-items: center; gap: 9px;
  padding: 4px 2px 2px;
  font-size: 13px;
  color: var(--fg-2);
  cursor: pointer;
  user-select: none;
}
.login-remember input {
  appearance: none;
  width: 15px; height: 15px;
  border-radius: 4px;
  border: 0.5px solid var(--border-2);
  background: var(--bg-2);
  display: grid; place-items: center;
  cursor: pointer;
  transition: background .12s, border-color .12s;
  flex: 0 0 auto;
}
.login-remember input:hover { border-color: var(--fg-3); }
.login-remember input:checked {
  background: var(--moss);
  border-color: var(--moss);
}
.login-remember input:checked::after {
  content: "";
  width: 8px; height: 5px;
  border-left: 1.5px solid var(--bg);
  border-bottom: 1.5px solid var(--bg);
  transform: rotate(-45deg) translate(0, -1px);
}

/* ── Submit ──────────────────────────────────────────────────────── */
.login-submit {
  margin-top: 6px;
  width: 100%;
  padding: 12px 16px;
  font-size: 13.5px;
  font-weight: 600;
  letter-spacing: 0.01em;
}
.login-submit:disabled {
  opacity: 0.55;
  cursor: not-allowed;
}

/* ── Card footer ─────────────────────────────────────────────────── */
.login-card__foot {
  margin-top: 22px;
  padding-top: 18px;
  border-top: 0.5px solid var(--hairline);
  display: flex; align-items: center; justify-content: space-between;
  font-size: 12px;
  color: var(--fg-3);
}

/* ── Phone ────────────────────────────────────────────────────────── */
@media (max-width: 480px) {
  .login-card { padding: 28px 22px 22px !important; border-radius: var(--r-md); }
  .login-card__head .display { font-size: 32px; }
}
