/* Append to crates/birdnet-web/static/css/app.css — purely additive.
   Post-upgrade banner (O-21). */

/* ── Update banner ────────────────────────────────────────────────── */
.bnb-banner {
  display: grid;
  grid-template-columns: auto 1fr auto auto;
  gap: 14px;
  align-items: center;
  padding: 10px 16px;
  background: color-mix(in oklch, var(--moss) 8%, var(--surface));
  border: 0.5px solid color-mix(in oklch, var(--moss) 26%, var(--border));
  border-radius: var(--r-md);
  margin: 0 0 var(--pad-3);
  font-size: 13px;
  transition: opacity .2s ease, transform .2s ease;
}
.bnb-banner[data-leaving="1"] {
  opacity: 0;
  transform: translateY(-4px);
}

.bnb-banner__copy {
  min-width: 0;
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.bnb-banner__copy strong { font-weight: 600; color: var(--fg); margin-right: 6px; }
.bnb-banner__copy span   { color: var(--fg-2); }

.bnb-banner__close {
  background: transparent;
  border: 0;
  color: var(--fg-3);
  font: inherit;
  font-size: 16px;
  line-height: 1;
  cursor: pointer;
  padding: 0 4px;
  border-radius: var(--r-xs);
}
.bnb-banner__close:hover { color: var(--fg); background: color-mix(in oklch, var(--moss) 4%, var(--surface)); }

/* ── Changelog page typography ────────────────────────────────────── */
.changelog-release { border-top: 0.5px solid var(--hairline); padding-top: 4px; }
.changelog-release:first-child { border-top: 0; }
.changelog-release ul { padding-left: 22px; margin: 4px 0 14px; }
.changelog-release li { margin: 4px 0; font-size: 14px; color: var(--fg-2); line-height: 1.55; }
.changelog-release h2 a:hover { color: var(--moss-ink); }

/* Anchor-link affordance: subtle # on hover */
.changelog-release h2 a::after {
  content: " #";
  color: var(--fg-4);
  font-size: 14px;
  opacity: 0;
  transition: opacity .12s;
}
.changelog-release h2 a:hover::after { opacity: 1; }

/* Mobile: stack the banner */
@media (max-width: 720px) {
  .bnb-banner {
    grid-template-columns: auto 1fr auto;
    grid-template-areas:
      "pill  copy  close"
      "btn   btn   btn";
  }
  .bnb-banner > .bnb-pill { grid-area: pill; }
  .bnb-banner__copy { grid-area: copy; }
  .bnb-banner__close { grid-area: close; }
  .bnb-banner > .bnb-btn { grid-area: btn; justify-self: stretch; }
}
