/* Append to crates/birdnet-web/static/css/app.css — purely additive.
   Signal-context overlays (O-23). */

/* ── Signal badges (text-glyph chips on the day-strip header) ─────── */
.bnb-signal {
  display: inline-flex; align-items: center; gap: 6px;
  font-size: 11.5px;
  color: var(--fg-3);
  font-variant-numeric: tabular-nums;
}
.bnb-signal__glyph {
  display: inline-grid; place-items: center;
  width: 18px; height: 18px;
  border-radius: 999px;
  background: var(--surface-2);
  font-size: 11px;
  color: var(--fg-2);
}
.bnb-signal__label { letter-spacing: 0.02em; }

/* Moon glyphs use the night/dawn tokens. */
.bnb-signal--moon[data-phase="full-moon"] .bnb-signal__glyph,
.bnb-signal--moon[data-phase="full"]      .bnb-signal__glyph {
  background: color-mix(in oklch, var(--dawn) 28%, var(--surface-2));
  color: var(--dawn-ink);
}
.bnb-signal--moon[data-phase="new-moon"] .bnb-signal__glyph,
.bnb-signal--moon[data-phase="new"]      .bnb-signal__glyph {
  background: var(--night);
  color: var(--bg);
}

/* ── Weather band (SVG group children) ───────────────────────────── */
.bnb-signal--weather .bnb-signal__bg {
  fill: var(--surface-2);
  opacity: 0.45;
}
.bnb-signal--weather .bnb-signal__placeholder {
  fill: var(--surface-2);
  opacity: 0.25;
}
.bnb-signal--weather .bnb-signal__temp {
  fill: none;
  stroke: color-mix(in oklch, var(--dawn) 60%, var(--moss));
  stroke-width: 1.4;
  stroke-linecap: round;
}
.bnb-signal--weather .bnb-signal__precip {
  stroke: var(--dawn);
  stroke-width: 1.5;
  stroke-linecap: round;
  opacity: 0.75;
}

/* ── SPL band ─────────────────────────────────────────────────────── */
.bnb-signal--spl .bnb-signal__spl {
  fill: none;
  stroke: color-mix(in oklch, var(--fg-3) 80%, var(--moss));
  stroke-width: 1.2;
  stroke-linecap: round;
}
.bnb-signal--spl .bnb-signal__quiet {
  stroke: var(--fg-4);
  stroke-width: 0.5;
  stroke-dasharray: 2 3;
  opacity: 0.6;
}
.bnb-signal--spl[data-state="empty"] {
  opacity: 0.45;
}

/* Overlay strip wrapper — sits just below the host chart. */
.bnb-overlay-strip {
  display: grid;
  grid-template-columns: auto 1fr auto auto;
  gap: 12px;
  align-items: center;
  padding: 6px 10px;
  margin-top: 6px;
  border-top: 0.5px solid var(--hairline);
  background: color-mix(in oklch, var(--surface) 80%, transparent);
  border-radius: 0 0 var(--r-md) var(--r-md);
}
.bnb-overlay-strip .bnb-signal { font-size: 11px; }
.bnb-overlay-strip svg { display: block; }
