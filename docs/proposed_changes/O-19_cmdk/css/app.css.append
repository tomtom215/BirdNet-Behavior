/* Append to crates/birdnet-web/static/css/app.css — purely additive.
   Command palette (O-19). Uses native <dialog> like O-17 but with a
   different chrome (no header, results-driven). */

/* ── Command palette dialog ───────────────────────────────────────── */
.bnb-cmdk {
  border: 0; padding: 0;
  background: transparent;
  color: var(--fg);
  max-width: min(94vw, 560px);
  width: 100%;
  margin: 12vh auto auto; /* top-aligned, like a real command bar */
}
.bnb-cmdk::backdrop {
  background: color-mix(in oklch, oklch(0% 0 0) 32%, transparent);
  backdrop-filter: blur(6px);
  -webkit-backdrop-filter: blur(6px);
}

.bnb-cmdk__shell {
  background: var(--surface);
  border: 0.5px solid var(--border);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-lg);
  overflow: hidden;
  display: flex; flex-direction: column;
  max-height: 70vh;
}

.bnb-cmdk__inputwrap {
  display: grid;
  grid-template-columns: auto 1fr auto auto;
  gap: 10px; align-items: center;
  padding: 12px 14px;
  border-bottom: 0.5px solid var(--hairline);
}
.bnb-cmdk__icon { color: var(--fg-3); font-size: 18px; line-height: 1; }
.bnb-cmdk__inputwrap input {
  border: 0; background: transparent; outline: 0;
  font: inherit; font-size: 15px; color: var(--fg);
  padding: 6px 0;
}
.bnb-cmdk__inputwrap input:focus { box-shadow: none; }
.bnb-cmdk__chip {
  font-size: 10.5px;
  padding: 3px 7px;
  border-radius: var(--r-xs);
  background: var(--surface-2);
  color: var(--fg-3);
  border: 0.5px solid var(--border);
}
.bnb-cmdk__loading {
  color: var(--moss-ink);
  font-size: 16px;
  line-height: 1;
  font-family: var(--font-mono);
}

.bnb-cmdk__results {
  list-style: none;
  margin: 0; padding: 6px 0;
  overflow-y: auto;
  flex: 1;
}

.bnb-cmdk__group {
  font-size: 10px;
  letter-spacing: 0.10em;
  text-transform: uppercase;
  font-weight: 500;
  color: var(--fg-4);
  padding: 12px 16px 4px;
  position: sticky; top: 0;
  background: linear-gradient(180deg, var(--surface) 80%, transparent);
}
.bnb-cmdk__results li[data-href] {
  display: grid;
  grid-template-columns: 22px 1fr auto;
  gap: 10px;
  align-items: center;
  padding: 8px 16px;
  cursor: pointer;
}
.bnb-cmdk__results li[data-href]:hover,
.bnb-cmdk__results li[data-href].is-active {
  background: color-mix(in oklch, var(--moss) 8%, var(--surface));
}
.bnb-cmdk__results li[data-href] .glyph {
  font-family: var(--font-mono);
  color: var(--fg-3);
  font-size: 11px;
  text-align: center;
}
.bnb-cmdk__results li[data-href] .label {
  font-size: 13.5px;
  color: var(--fg);
  white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.bnb-cmdk__results li[data-href] .label em {
  color: var(--moss-ink);
  font-style: normal;
  font-weight: 600;
}
.bnb-cmdk__results li[data-href] .sub {
  font-family: var(--font-mono);
  font-size: 10.5px;
  color: var(--fg-3);
  white-space: nowrap;
}
.bnb-cmdk__results .bnb-cmdk__empty {
  padding: 28px 16px;
  text-align: center;
  color: var(--fg-3);
  font-size: 13px;
}

.bnb-cmdk__foot {
  display: flex; gap: 18px; justify-content: flex-start;
  padding: 8px 14px;
  border-top: 0.5px solid var(--hairline);
  background: var(--bg-2);
  font-size: 10.5px;
  color: var(--fg-3);
}
.bnb-cmdk__foot kbd {
  display: inline-block;
  padding: 1px 5px;
  border-radius: 3px;
  background: var(--surface);
  border: 0.5px solid var(--border);
  color: var(--fg-2);
  font-family: var(--font-mono);
  font-size: 10px;
  margin-right: 3px;
}

@media (max-width: 540px) {
  .bnb-cmdk { margin: 6vh auto; }
  .bnb-cmdk__shell { max-height: 80vh; }
  .bnb-cmdk__chip { display: none; }
}
