/* Append to crates/birdnet-web/static/css/app.css — purely additive.
   Help / methodology surface (O-20). */

/* ── Inline help link (used in section headers) ───────────────────── */
.bnb-help-link {
  display: inline-flex; align-items: center; gap: 6px;
  padding: 3px 9px;
  font-size: 11.5px;
  color: var(--fg-3);
  text-decoration: none;
  border-radius: 999px;
  background: transparent;
  border: 0.5px solid transparent;
  cursor: pointer;
  font: inherit;
  font-size: 11.5px;
  transition: color .12s, background .12s, border-color .12s;
}
.bnb-help-link:hover {
  color: var(--moss-ink);
  background: color-mix(in oklch, var(--moss) 7%, var(--surface));
  border-color: color-mix(in oklch, var(--moss) 20%, transparent);
  text-decoration: none;
}
.bnb-help-link__glyph {
  display: inline-grid; place-items: center;
  width: 14px; height: 14px;
  border-radius: 999px;
  background: var(--surface-2);
  color: var(--fg-3);
  font-family: var(--font-mono);
  font-size: 9px; font-weight: 600;
}
.bnb-help-link:hover .bnb-help-link__glyph {
  background: var(--moss-soft); color: var(--moss-ink);
}
.bnb-help-link__arrow {
  font-size: 10px; color: var(--fg-4);
  transition: transform .12s, color .12s;
}
.bnb-help-link:hover .bnb-help-link__arrow {
  color: var(--moss-ink);
  transform: translateX(1px);
}

/* ── Right-side drawer (in-context docs) ──────────────────────────── */
.bnb-help-drawer {
  border: 0; padding: 0;
  background: transparent;
  color: var(--fg);
  margin: 0 0 0 auto;          /* right-aligned */
  height: 100vh;
  width: min(94vw, 540px);
  max-width: 540px;
}
.bnb-help-drawer::backdrop {
  background: color-mix(in oklch, oklch(0% 0 0) 32%, transparent);
  backdrop-filter: blur(2px);
  -webkit-backdrop-filter: blur(2px);
}

.bnb-help-drawer__head {
  display: grid;
  grid-template-columns: auto 1fr auto auto;
  gap: 12px;
  align-items: center;
  padding: 14px 18px;
  background: var(--surface);
  border-bottom: 0.5px solid var(--hairline);
}
.bnb-help-drawer__head .bnb-eyebrow { white-space: nowrap; }

.bnb-help-drawer__body {
  background: var(--surface);
  height: calc(100vh - 56px);
  overflow-y: auto;
  padding: 22px 24px 64px;
  font-size: 14.5px; line-height: 1.6;
  color: var(--fg-2);
}
/* mdBook content typography — keep close to the rest of the app */
.bnb-help-drawer__body h2 {
  font-family: var(--font-display);
  font-size: 22px; letter-spacing: -0.01em; font-weight: 400;
  color: var(--fg);
  margin: 28px 0 8px;
}
.bnb-help-drawer__body h3 { font-size: 15px; font-weight: 500; color: var(--fg); margin: 22px 0 6px; }
.bnb-help-drawer__body p { margin: 8px 0; }
.bnb-help-drawer__body a { color: var(--moss-ink); text-decoration: none; border-bottom: 0.5px solid color-mix(in oklch, var(--moss-ink) 30%, transparent); }
.bnb-help-drawer__body a:hover { border-bottom-color: var(--moss-ink); }
.bnb-help-drawer__body code {
  font-family: var(--font-mono);
  font-size: 12.5px;
  padding: 1px 5px;
  background: var(--surface-2);
  border: 0.5px solid var(--hairline);
  border-radius: var(--r-xs);
  color: var(--fg-2);
}
.bnb-help-drawer__body pre {
  background: var(--surface-2);
  border: 0.5px solid var(--hairline);
  border-radius: var(--r-md);
  padding: 12px 14px;
  font-size: 12.5px;
  overflow-x: auto;
}
.bnb-help-drawer__body pre code { background: transparent; border: 0; padding: 0; }
.bnb-help-drawer__body ul, .bnb-help-drawer__body ol { padding-left: 20px; }
.bnb-help-drawer__body li { margin: 4px 0; }
.bnb-help-drawer__body blockquote {
  border-left: 2px solid var(--moss);
  padding: 4px 14px;
  margin: 12px 0;
  color: var(--fg-3);
  background: color-mix(in oklch, var(--moss) 4%, var(--surface));
  border-radius: 0 var(--r-sm) var(--r-sm) 0;
}
.bnb-help-drawer__body img {
  max-width: 100%; height: auto;
  border-radius: var(--r-md);
  border: 0.5px solid var(--hairline);
}

/* Slide-in animation */
@media (prefers-reduced-motion: no-preference) {
  .bnb-help-drawer[open] {
    animation: bnb-help-drawer-slide 220ms cubic-bezier(.2,.7,.2,1);
  }
}
@keyframes bnb-help-drawer-slide {
  from { transform: translateX(100%); }
  to   { transform: translateX(0); }
}

/* Mobile: drawer becomes a bottom sheet. */
@media (max-width: 720px) {
  .bnb-help-drawer { margin: auto 0 0 0; width: 100vw; max-width: 100vw; height: 78vh; }
  .bnb-help-drawer[open] { animation: bnb-help-drawer-sheet 220ms cubic-bezier(.2,.7,.2,1); }
}
@keyframes bnb-help-drawer-sheet {
  from { transform: translateY(100%); }
  to   { transform: translateY(0); }
}
