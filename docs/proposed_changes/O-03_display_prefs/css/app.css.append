/* Append to crates/birdnet-web/static/css/app.css
   — wires the two new preference keys read by the display-prefs card.
   No changes to existing rules; purely additive. */

/* ── Motion override (in addition to OS prefers-reduced-motion) ──── */
:root[data-motion="reduced"] *,
:root[data-motion="reduced"] *::before,
:root[data-motion="reduced"] *::after {
  animation-duration: 0.001ms !important;
  animation-iteration-count: 1 !important;
  transition-duration: 0.001ms !important;
}
:root[data-motion="reduced"] .bnb-dot.live,
:root[data-motion="reduced"] .live-dot { animation: none; }

/* ── High-contrast override (in addition to OS prefers-contrast) ─── */
:root[data-contrast="high"] {
  /* Darken borders, intensify ink. Light theme. */
  --border:   oklch(72% 0.010 80);
  --border-2: oklch(58% 0.012 80);
  --hairline: oklch(82% 0.010 80);
  --fg-3:     oklch(40% 0.010 70);
  --fg-4:     oklch(55% 0.012 70);
}
:root[data-contrast="high"][data-theme="dark"] {
  /* Dark theme high-contrast — brighter text/borders. */
  --border:   oklch(46% 0.018 250);
  --border-2: oklch(58% 0.022 250);
  --hairline: oklch(40% 0.016 250);
  --fg-3:     oklch(78% 0.012 240);
  --fg-4:     oklch(62% 0.014 240);
}

/* High-contrast: thicken the half-pixel hairlines that look great at standard
   contrast but disappear when the user explicitly asks for sharper edges. */
:root[data-contrast="high"] .bnb-card,
:root[data-contrast="high"] .stat-row,
:root[data-contrast="high"] .stat-card,
:root[data-contrast="high"] .card,
:root[data-contrast="high"] .bnb-btn {
  border-width: 1px;
}
