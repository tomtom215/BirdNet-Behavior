      "url": "/migration",
      "icons": [{ "src": "/static/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Quarantine",
      "short_name": "Review",
      "description": "Rare-bird review queue",
      "url": "/quarantine",
      "icons": [{ "src": "/static/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
