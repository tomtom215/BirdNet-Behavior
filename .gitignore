# Rust build artifacts
/target/

# Editor/IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Environment
.env
.env.local

# Database files (runtime)
*.db
*.db-wal
*.db-shm
*.duckdb
*.duckdb.wal

# Audio files (runtime)
*.wav
*.flac
*.mp3

# But keep test audio fixtures
!tests/testdata/*.wav

# BirdNET model files
*.tflite
*.onnx

# But keep tiny test fixtures embedded via include_bytes!()
# Used by inference/model.rs to drive BirdNetModel methods without
# the real 541 MB BirdNET+ model on disk.
!crates/birdnet-core/src/testdata/*.onnx

# Coverage/profiling
*.profraw
lcov.info
tarpaulin-report.html
mutants.out/
mutants.out.old/

# proptest failure-case seeds. Regenerated locally whenever a proptest fails —
# including every time cargo-mutants makes one fail to catch a mutant — so the
# directory is noise rather than a curated regression corpus here.
proptest-regressions/

# Local scratch dir for the visual-QA screenshot pipeline (Playwright +
# node_modules + captured PNGs). The committed tooling lives in tools/visual-qa/.
.screenshot-tooling/

# Durable cache for the prebuilt ONNX Runtime static lib (~90 MB) and the
# throwaway extractor crate. Survives sandbox reclaim because it lives inside
# the repo dir, but must never be committed. See tools/visual-qa/README.md.
.ort-durable/

# mdBook build output (the docs site is built + deployed by .github/workflows/docs.yml)
docs/.book-build/

# mdBook build output from the workspace `build.rs` (O-20). The runtime
# `ServeDir` at `/help/*` reads from this directory; every cargo build
# re-renders into it, so it's a build artifact, never a checked-in tree.
docs/book/_generated/html/

# Fuzzing build/run output (fuzz/ is workspace-excluded; see fuzz/README.md).
# Curated seeds under fuzz/corpus/*/seed-* ARE committed.
fuzz/target/
fuzz/artifacts/
fuzz/Cargo.lock
fuzz/corpus/**
!fuzz/corpus/*/
!fuzz/corpus/*/seed-*

# Node tooling for the Playwright visual-QA script (scripts/visual_qa.mjs).
# Installed on demand; never committed.
node_modules/
package.json
package-lock.json

# Python bytecode from scripts/ (check-ci-config.py)
__pycache__/
*.py[cod]
